dist/
__pycache__/
*.pyc
.briefs/
.tmp-tests/
.knowledge-export-*/
mods/*/.claude-plugin/types/
mods/*/tsconfig.json
mods/*/node_modules/
scratch/
# Codex CLI writes error.log into the folder it runs in; it can hold account ids.
error.log
.hpc-spool/
# Local Claude Code files stay out of git; the cloud-notify hook, the settings that register it and the kit's lane
# agents (for this repository's mirror) are shared. The release bundle leaves all of .claude/ out.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
/.claude/hooks/*
!/.claude/hooks/cloud-notify.py
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/lane-*.md
# cloud-notify: marks this checkout's main cloud session; never commit it
.claude/main-session
# Amp's own plugin API docs, dumped locally by `amp plugins show-docs` (third-party text; regenerate, do not commit)
plans/amp-codex/amp-plugin-api-local.md
plans/amp-codex/probe/raw/
# P1 probe dump of the newer Amp plugin API (same rule as the local dump; regenerate, do not commit)
plans/amp-codex/amp-plugin-api-new.md
plans/amp-codex/probe/codex-schema/
